# Copy this file to .env for local development. Do not commit .env.
# Values below are placeholders only.
HEALTH_LOG_ENVIRONMENT=development
AWS_REGION=eu-west-3
HEALTH_LOG_TABLE_NAME=HealthLogs-dev
HEALTH_LOG_DASHBOARD_ORIGIN=http://localhost:8080
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_WEBHOOK_SECRET=replace-with-random-webhook-secret
TELEGRAM_ALLOWED_USER_IDS=123456789
DASHBOARD_PASSWORD_HASH=replace-with-argon2id-or-bcrypt-hash
SESSION_SIGNING_KEY=replace-with-at-least-32-random-characters

# Optional. When omitted, AI insights are disabled.
GEMINI_API_KEY=

# Optional. Defaults to health_log_session and 8h.
SESSION_COOKIE_NAME=health_log_session
SESSION_TTL=8h
